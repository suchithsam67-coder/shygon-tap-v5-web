{
  "name": "shygon-tap-v5-customer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:apply": "node supabase/tests/apply.mjs",
    "db:verify": "node supabase/tests/verify.mjs",
    "db:bundle": "node supabase/tests/bundle.mjs",
    "db:push": "node supabase/tests/apply-remote.mjs",
    "brand": "node scripts/brand/generate.mjs",
    "test:payments": "node netlify/tests/payments-and-sms.mjs && node netlify/tests/functions-security.mjs",
    "test:payments:ci": "node --import ./scripts/ci/deny-network.mjs netlify/tests/payments-and-sms.mjs && node --import ./scripts/ci/deny-network.mjs netlify/tests/functions-security.mjs",
    "test:db": "npm run db:apply && npm run db:verify && node supabase/tests/rls-adversarial.mjs && npm run test:identity && npm run test:golden && npm run test:admin-contract && npm run test:db:history",
    "test:identity": "node supabase/tests/identity-contract.mjs",
    "test:golden": "node supabase/tests/golden-public-tap.mjs",
    "test:admin-contract": "node supabase/tests/admin-contract.mjs",
    "test:db:history": "node supabase/tests/history-seed.mjs",
    "test:push-guard": "node supabase/tests/db-push-guard.mjs",
    "test:bundle": "node scripts/check-bundle-size.mjs",
    "test:secrets": "node scripts/ci/secret-scan.mjs",
    "ci": "npm run lint && npm run build && npm run test:bundle && npm run test:push-guard && npm run test:db && npm run test:payments:ci && npm run test:secrets && npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "opentype.js": "^1.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
