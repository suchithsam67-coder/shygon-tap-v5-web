{
  "name": "shygon-tap-v5-customer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:apply": "node supabase/tests/apply.mjs",
    "db:verify": "node supabase/tests/verify.mjs",
    "db:bundle": "node supabase/tests/bundle.mjs",
    "db:push": "node supabase/tests/apply-remote.mjs",
    "brand": "node scripts/brand/generate.mjs",
    "test:payments": "node scripts/run-tests.mjs netlify/tests/payments-and-sms.mjs netlify/tests/functions-security.mjs",
    "test:payments:ci": "node scripts/run-tests.mjs --deny-network netlify/tests/payments-and-sms.mjs netlify/tests/functions-security.mjs",
    "test:payment-chain": "node --import ./scripts/ci/deny-network.mjs netlify/tests/payment-chain.mjs",
    "test:public-tap": "node --import ./scripts/ci/deny-network.mjs supabase/tests/public-tap.mjs",
    "test:suspension": "node --import ./scripts/ci/deny-network.mjs supabase/tests/suspension-guard.mjs",
    "test:emergency": "node --import ./scripts/ci/deny-network.mjs supabase/tests/emergency.mjs",
    "test:rescue": "node --import ./scripts/ci/deny-network.mjs supabase/tests/rescue.mjs",
    "test:connect": "node --import ./scripts/ci/deny-network.mjs supabase/tests/connect.mjs",
    "test:prive": "node --import ./scripts/ci/deny-network.mjs supabase/tests/prive.mjs",
    "test:modes": "node --import ./scripts/ci/deny-network.mjs supabase/tests/modes.mjs",
    "test:bq1-production": "node --import ./scripts/ci/deny-network.mjs supabase/tests/bq1-production.mjs",
    "test:verified-tap": "node --import ./scripts/ci/deny-network.mjs supabase/tests/verified-tap.mjs",
    "test:sun": "node --import ./scripts/ci/deny-network.mjs netlify/tests/sun.mjs",
    "test:account-export": "node --import ./scripts/ci/deny-network.mjs supabase/tests/account-export.mjs",
    "test:phone-verify": "node --import ./scripts/ci/deny-network.mjs supabase/tests/phone-verify.mjs",
    "test:admin-mfa": "node --import ./scripts/ci/deny-network.mjs supabase/tests/admin-mfa.mjs",
    "test:card-lifecycle": "node --import ./scripts/ci/deny-network.mjs supabase/tests/card-lifecycle.mjs",
    "test:age-gate": "node --import ./scripts/ci/deny-network.mjs supabase/tests/age-gate.mjs",
    "test:preview-checks": "node --import ./scripts/ci/deny-network.mjs scripts/release/preview-checks.test.mjs",
    "test:local-host": "node --import ./scripts/ci/deny-network.mjs supabase/tests/local-host.mjs",
    "test:admin-edge": "node --import ./scripts/ci/deny-network.mjs supabase/tests/admin-edge.mjs",
    "test:observability": "node --import ./scripts/ci/deny-network.mjs netlify/tests/observability.mjs",
    "test:security": "node --import ./scripts/ci/deny-network.mjs netlify/tests/security.mjs",
    "test:bundle-secrets": "node scripts/ci/check-bundle-secrets.mjs dist",
    "test:seo": "node scripts/ci/check-seo.mjs dist",
    "test:account-deletion": "node supabase/tests/account-deletion.mjs",
    "test:components": "vitest run",
    "stack": "node supabase/local/serve.mjs",
    "test:e2e": "playwright test",
    "test:db": "node scripts/run-tests.mjs db:apply db:verify supabase/tests/rls-adversarial.mjs test:rls-matrix test:identity test:admin-notes test:card-otp-limits test:golden test:admin-contract test:rollbacks test:account-deletion db:bundle:check test:db:history",
    "test:identity": "node supabase/tests/identity-contract.mjs",
    "test:golden": "node supabase/tests/golden-public-tap.mjs",
    "test:admin-contract": "node supabase/tests/admin-contract.mjs",
    "test:rls-matrix": "node supabase/tests/rls-matrix.mjs",
    "test:admin-notes": "node supabase/tests/admin-notes.mjs",
    "test:card-otp-limits": "node supabase/tests/card-otp-limits.mjs",
    "test:rollbacks": "node supabase/tests/migration-rollbacks.mjs",
    "db:bundle:check": "node supabase/tests/bundle.mjs --check",
    "test:db:history": "node supabase/tests/history-seed.mjs",
    "test:push-guard": "node supabase/tests/db-push-guard.mjs",
    "test:bundle": "node scripts/check-bundle-size.mjs",
    "test:secrets": "node scripts/ci/secret-scan.mjs",
    "audit:high": "npm audit --audit-level=high",
    "ci": "node scripts/run-tests.mjs lint build test:bundle test:bundle-secrets test:seo test:push-guard test:db test:payments:ci test:payment-chain test:public-tap test:suspension test:emergency test:rescue test:connect test:prive test:modes test:bq1-production test:sun test:verified-tap test:account-export test:phone-verify test:admin-mfa test:card-lifecycle test:age-gate test:preview-checks test:local-host test:admin-edge test:observability test:security test:components test:secrets audit:high"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "opentype.js": "^1.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
