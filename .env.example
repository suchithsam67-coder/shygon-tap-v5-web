# ---------------------------------------------------------------------------
# Browser-exposed. Vite inlines every VITE_* value into the JS bundle, so
# treat all of these as public. That is fine: the Supabase anon key is guarded
# by RLS and the Razorpay key id is designed to be public.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ---------------------------------------------------------------------------
# Server-only. NEVER prefix these VITE_ — that would ship the secret to every
# visitor. Never commit real values; configure them in each runtime instead.
#
# Two runtimes read them, and each sees only its own environment:
#   Netlify > Environment variables   customer checkout + webhook: all below
#   Supabase > Edge Function Secrets  admin-refund: RAZORPAY_KEY_ID and
#                                     RAZORPAY_KEY_SECRET (Supabase injects
#                                     SUPABASE_URL and the service-role key)
# Set only in Supabase, customer checkout returns 503. See RAZORPAY_SETUP.md.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_server_only_key_secret

# NOT the API key secret. Created when you add the webhook in the Razorpay
# dashboard. razorpay-webhook refuses to run without it.
RAZORPAY_WEBHOOK_SECRET=

# Supabase service role (Settings > API). Used by the functions to fulfil
# orders. Every function returns 503 until this is set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Canonical site origin. Optional — defaults to https://shygontech.com.
#
# This is the address baked into every printed QR and into the public Tap link
# a customer shares, so it must NOT follow whatever host the browser happens to
# be on: a QR generated from a deploy preview would encode a host that expires.
# Set it only for a staging deploy, or locally if you want Tap links to open
# against your own dev server (e.g. http://localhost:5173).
#
# LEAVE IT COMMENTED OUT unless you have one of those reasons. Unset is the
# correct production value, and a card cannot be reprinted once it has shipped.
#
# `vite build` enforces this: it refuses to produce a bundle whose
# VITE_SITE_URL is localhost, a LAN address, or plain http. Any https origin
# passes, so staging still works. To build a local preview on purpose, prefix
# the command with ALLOW_LOCAL_SITE_URL=1 — and do not deploy that bundle.
# ---------------------------------------------------------------------------
# VITE_SITE_URL=https://shygontech.com

# ---------------------------------------------------------------------------
# Card activation / deactivation by SMS one-time password (card-otp function,
# migration 015). Server-only — set in Netlify > Environment variables.
#
#   OTP_SECRET        long random string; keys the stored code hashes
#                     (falls back to the service-role key if unset)
#   SMS_PROVIDER      msg91 | twilio
#
#   msg91 (India, DLT): MSG91_AUTH_KEY, MSG91_TEMPLATE_ID (a DLT-approved flow
#                     template containing ##otp##), MSG91_OTP_VAR (default otp)
#   twilio:           TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and TWILIO_FROM or
#                     TWILIO_MESSAGING_SERVICE_SID
#
#   OTP_DEV_MODE=true local testing only: `npm run dev` returns the code on
#                     screen instead of texting it. Ignored on any deployed
#                     site (production context or a non-localhost request).
# ---------------------------------------------------------------------------
OTP_SECRET=
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
OTP_DEV_MODE=

# ---------------------------------------------------------------------------
# Order confirmation text (sent once when a paid order is fulfilled, to the
# checkout phone number). Uses SMS_PROVIDER above.
#   MSG91: a second DLT-approved Flow template, e.g.
#     "SHYGON Tap: your order ##order## is confirmed. Rs ##amount## paid. We will
#      text you when it ships."
#   Twilio: nothing extra (free text).
# Needs migration 019 (orders.confirmation_sms_at / _status).
# ---------------------------------------------------------------------------
MSG91_ORDER_TEMPLATE_ID=
MSG91_ORDER_VAR=order
MSG91_AMOUNT_VAR=amount

# ---------------------------------------------------------------------------
# Physical card sales (DEC-2026-035, D-10). The V6 release candidate is
# digital-first: cards are shown as "coming soon" and cannot be ordered. Leave
# BOTH unset until the card release, then set both to true together:
#   VITE_CARD_SALES_ENABLED  what the pages offer (browser, build time)
#   CARD_SALES_ENABLED       what create-order accepts (server); it refuses
#                            card orders on its own while unset
# ---------------------------------------------------------------------------
# VITE_CARD_SALES_ENABLED=true
# CARD_SALES_ENABLED=true

# ---------------------------------------------------------------------------
# Real payments. Swap the three Razorpay values above for LIVE ones
# (rzp_live_...) in the host's settings, not here. Live keys are refused on a
# localhost server unless this is true — keep it unset.
# ---------------------------------------------------------------------------
ALLOW_LIVE_PAYMENTS_LOCALLY=

# ---------------------------------------------------------------------------
# SHYGON AAROH server settings (migrations 029-033; see
# docs/v6/aaroh/provider-requirements.md for every value and when to set it).
# All are UNSET by default and stay unset until the owner decides otherwise.
# Set them in the host's settings, never in a committed file.
#
# Visitor-facing switches: the exact value "on" turns one on; anything else,
# or unset, keeps it off.
#   EMERGENCY_PUBLIC_ALERTS  visitor emergency alerts (DEC-2026-038 Q2: off)
#   RESCUE_RELAY             the Return-to-Owner finder side (Q12)
#   CONNECT_PUBLIC           SHYGON Connect for visitors (DEC-2026-039 A-1)
# EMERGENCY_PUBLIC_ALERTS=
# RESCUE_RELAY=
# CONNECT_PUBLIC=
#
# The visitor address header this host sets itself (B-9). Netlify:
# x-nf-client-connection-ip. Vercel: x-vercel-forwarded-for. Unset: visitor
# alerts and finder starts are refused. Set it before either switch above, and
# only after the preview check in docs/v6/aaroh/B-9_client-address-plan.md.
# TRUSTED_CLIENT_IP_HEADER=
#
# The scheduled sweep (/api/emergency-dispatch): a random value of 32 or more
# characters, sent by the host scheduler as a bearer token.
# CRON_SECRET=
#
# Emergency SMS through MSG91 (DLT templates) and its delivery reports.
# MSG91_EMERGENCY_VERIFY_TEMPLATE_ID=
# MSG91_EMERGENCY_OWNER_TEMPLATE_ID=
# MSG91_EMERGENCY_PUBLIC_TEMPLATE_ID=
# MSG91_DLR_SECRET=
# Twilio delivery receipts: exactly https://<production host>/api/sms-status
# SMS_STATUS_CALLBACK_URL=
#
# SHYGON Prive is demo-only: leave unset (or "demo"); any other value makes
# /api/prive refuse.
# HOTEL_PROVIDER=
# ---------------------------------------------------------------------------
